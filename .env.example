# Shared controller configuration. Never pass this file into SUT/browser workers.
INSTANCE=lab
MATRIX=cdp
VNC_PORT=6080
REPORT_PORT=8088
APP_ALLOW_NETWORK=0
# APP=/absolute/project
# APP_IMAGE=node:22-bookworm-slim
# APP_INSTALL=npm ci
# APP_COMMAND=npm run dev -- --host 0.0.0.0 --port 8080
# APP_PORT=8080
# CONFIG=configs/audit.yaml
# SUT_ENV_FILE=/absolute/synthetic-test-secrets.env

# One selected provider; all credentials remain on the controller.
LLM_PROVIDER=openrouter
# LLM_PROVIDER=zai
# LLM_PROVIDER=zai-coding
# LLM_PROVIDER=deepseek
# LLM_PROVIDER=ollama
# LLM_PROVIDER=custom
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
# ZAI_API_KEY=
# ZAI_MODEL=
# ZAI_VISION_MODEL=
# ZAI_CODING_MODEL=
# ZAI_CODING_VISION_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# DEEPSEEK_VISION_MODEL=
# OLLAMA_MODEL=
# OLLAMA_VISION_MODEL=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=https://your-reviewed-provider.example/v1
# CUSTOM_MODEL=
# CUSTOM_VISION_MODEL=
# Generic overrides take precedence over the selected provider profile:
# LLM_MODEL=
# LLM_VISION_MODEL=
# LLM_API_KEY=
# LLM_BASE_URL=
# Model identifiers are intentionally not guessed. Set an existing image-capable
# model at your provider; a coding/text model is not automatically vision-capable.
LLM_ALLOW_REMOTE=0
LLM_VISION_CAPABLE=0
LLM_MAX_CALLS=3
LLM_MAX_TOKENS=2200
LLM_TIMEOUT=60

# Local reviewed model only. No bundled weights / automatic download.
# YOLO_WEIGHTS=/absolute/models/gui.pt
# YOLO_SHA256=

# Source fallback for the public TestQL verification contract.
# Replace main with a reviewed full commit SHA for a release build.
TESTQL_REF=main
PLANFILE_REF=main
# PLANFILE_PROJECT=/absolute/project-with-.planfile
APPLY=0
READY=0
TICKET_LIMIT=25
TICKET_OFFSET=0

# Optional read-only browser state mount; keep synthetic accounts only.
# AUTH_DIR=/absolute/private/.auth
# Config sessions must use /auth/user.json and match the actual SUT origin.
